                  <rdf:li rdf:resource="http://identifiers.org/doi:10.3389/fpls.2020.00741" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
              <bqbiol:isVersionOf>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/kegg:ath00908" />
                </rdf:Bag>
              </bqbiol:isVersionOf>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
