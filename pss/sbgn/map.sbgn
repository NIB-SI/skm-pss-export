                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/skm:rx00875" />
                </rdf:Bag>
              </bqbiol:is>
              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1038/s41586-024-07100-0" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="12539.4" y="3573.2" w="20.0" h="20.0" />
      <port id="rx00875.in" x="12549.4" y="3558.2" />
      <port id="rx00875.out" x="12549.4" y="3608.2" />
    </glyph>
