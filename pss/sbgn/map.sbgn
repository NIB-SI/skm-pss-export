      <bbox x="14447.7" y="6575.6" w="20.0" h="20.0" />
      <port id="rx00580.in" x="14457.7" y="6560.6" />
      <port id="rx00580.out" x="14457.7" y="6610.6" />
    </glyph>
    <glyph class="association" id="rx00581" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00581</html:p>
          <html:p>type: binding/oligomerisation</html:p>
          <html:p>mechanism: binding</html:p>
          <html:p>evidence: HC-Pro was shown to sequester viral siRNAs away from AGO1, AGO2 and AGO10, leading to the obvious proposal that HC-Pro interferes with antiviral silencing by preventing AGOs from loading with virus-derived siRNAs.</html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
            <rdf:Description rdf:about="#rx00581">
              <bqbiol:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/skm:rx00581" />
                </rdf:Bag>
              </bqbiol:is>
              <bqmodel:isDescribedBy>
