                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1104/pp.109.135848" />
                  <rdf:li rdf:resource="http://identifiers.org/pubmed:19297586" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
