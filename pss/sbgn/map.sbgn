                </rdf:Bag>
              </bqbiol:is>
              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1111/j.1365-313x.2012.04972.x" />
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1104/pp.113.229807" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
              <bqbiol:isVersionOf>
