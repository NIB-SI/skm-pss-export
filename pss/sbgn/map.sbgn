    <glyph class="process" id="rx00706" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00706</html:p>
          <html:p>type: catalysis</html:p>
          <html:p>evidence: The first and committed step in proline synthesis from glutamate is catalyzed by δ1‐pyrroline‐5‐carboxylate synthetase</html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
            <rdf:Description rdf:about="#rx00706">
              <bqbiol:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/skm:rx00706" />
                </rdf:Bag>
              </bqbiol:is>
