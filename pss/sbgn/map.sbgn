                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1073/pnas.1005225107" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
