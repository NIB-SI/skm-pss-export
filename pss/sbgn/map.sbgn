                </rdf:Bag>
              </bqbiol:is>
              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1104/pp.111.181560" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="12338.2" y="5681.9" w="20.0" h="20.0" />
      <port id="rx00345.in" x="12348.2" y="5666.9" />
      <port id="rx00345.out" x="12348.2" y="5716.9" />
    </glyph>
    <glyph class="process" id="rx00348" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00348</html:p>
          <html:p>type: catalysis</html:p>
          <html:p>evidence: UGT76C1 and UGT76C2 recognized all cytokinins and glucosylated the hormones at the N7 and N9 positions. UGT85A1, UGT73C5, and UGT73C1 recognized trans-zeatin and dihydrozeatin, which have an available hydroxyl group for glucosylation and formed the O-glucosides. </html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
