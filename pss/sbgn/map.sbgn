                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1126/science.abg7917" />
                  <rdf:li rdf:resource="http://identifiers.org/pubmed:34140391" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="575.9" y="6230.9" w="20.0" h="20.0" />
      <port id="rx00943.in" x="585.9" y="6215.9" />
      <port id="rx00943.out" x="585.9" y="6265.9" />
    </glyph>
    <glyph class="process" id="rx00946" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00946</html:p>
          <html:p>type: protein activation</html:p>
          <html:p>mechanism: phosphorylation</html:p>
          <html:p>evidence: In vitro kinase assays demonstrated that the CPK3/4/6/11/27 protein kinases directly interact with and phosphorylate the downstream SnRK2 protein kinases.</html:p>
        </html:body>
      </notes>
