    <glyph class="unspecified entity" id="s_Photosynthesis_chl_pr" compartmentRef="c_chl">
      <notes>
        <html:body>
          <html:p>description: Photosynthesis is a process in which energy from sunlight is harvested and used to fix CO2 into carbohydrates. During photosynthesis the solar energy is trapped by light-harvesting complexes, and used to split a donor molecule, generating high potential electrons that are channeled to NADP+, forming NADPH, which can be used to reduce CO2.</html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
            <rdf:Description rdf:about="#s_Photosynthesis_chl_pr">
              <bqbiol:isVersionOf>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/biocyc:META:PHOTOALL-PWY" />
                  <rdf:li rdf:resource="http://identifiers.org/kegg:ath00195" />
                </rdf:Bag>
              </bqbiol:isVersionOf>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <label text="Photosynthesis" />
      <bbox x="12623.4" y="5172.0" w="120.0" h="40.0" />
    </glyph>
