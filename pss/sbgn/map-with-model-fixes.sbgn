              <bqbiol:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/skm:rx00875" />
                </rdf:Bag>
              </bqbiol:is>
              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1038/s41586-024-07100-0" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="18817.9" y="1811.8" w="20.0" h="20.0" />
      <port id="rx00875.in" x="18827.9" y="1796.8" />
      <port id="rx00875.out" x="18827.9" y="1846.8" />
    </glyph>
