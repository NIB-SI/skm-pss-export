                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1099/vir.0.060269-0" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="17855.4" y="5544.7" w="20.0" h="20.0" />
      <port id="rx00581.in" x="17865.4" y="5529.7" />
      <port id="rx00581.out" x="17865.4" y="5579.7" />
    </glyph>
    <glyph class="process" id="rx00582" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00582</html:p>
          <html:p>type: transcriptional/translational activation</html:p>
          <html:p>mechanism: translation</html:p>
          <html:p>evidence: Inside the infected cells, the viral RNA of potyvirids is uncoated and translated into polyproteins which are proteolytically processed by viral-encoded proteinases producing, in most cases, the following mature viral gene products: P1, the helper component proteinase (HCPro), P3, 6K1, CI, 6K2, NIa (VPg + Pro), NIb and CP. </html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
            <rdf:Description rdf:about="#rx00582">
