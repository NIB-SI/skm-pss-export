                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="14684.1" y="6615.2" w="20.0" h="20.0" />
      <port id="rx00642.in" x="14694.1" y="6600.2" />
      <port id="rx00642.out" x="14694.1" y="6650.2" />
    </glyph>
    <glyph class="process" id="rx00643" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00643</html:p>
          <html:p>type: catalysis</html:p>
          <html:p>evidence: In the two-step pathway, cytokinin ribotides are successively converted to the their ribosides and free bases, by as yet unidentified enzymes. </html:p>
        </html:body>
      </notes>
