              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1093/plcell/koaa007" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="14225.1" y="3131.6" w="20.0" h="20.0" />
      <port id="rx00524.in" x="14235.1" y="3116.6" />
      <port id="rx00524.out" x="14235.1" y="3166.6" />
    </glyph>
    <glyph class="process" id="rx00525" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00525</html:p>
          <html:p>type: protein deactivation</html:p>
          <html:p>evidence: These results indicate that EIN2 is a direct substrate of TOR kinase. TOR-mediated phosphorylation of EIN2 prevents its nuclear localization.</html:p>
        </html:body>
      </notes>
