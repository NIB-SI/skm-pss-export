                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1104/pp.113.229807" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
              <bqbiol:isVersionOf>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/ec-code:1.2.1.28" />
                  <rdf:li rdf:resource="https://pmn.plantcyc.org/ARA/new-image?object=BENZALDEHYDE-DEHYDROGENASE-NAD+-RXN" />
                </rdf:Bag>
              </bqbiol:isVersionOf>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="12298.4" y="5360.4" w="20.0" h="20.0" />
      <port id="rx00537.in" x="12308.4" y="5345.4" />
      <port id="rx00537.out" x="12308.4" y="5395.4" />
    </glyph>
    <glyph class="process" id="rx00538" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00538</html:p>
          <html:p>type: catalysis</html:p>
          <html:p>evidence: Here, we report that Arabidopsis siliques contain an enzymatic activity capable of converting BD to BA. We further show that at least some of this activity resides in a 145-kD protein, designated ARABIDOPSIS ALDEHYDE OXIDASE4 (AAO4) [...]. </html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
