                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1104/pp.16.00860" />
                  <rdf:li rdf:resource="http://identifiers.org/pubmed:27493213" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="14965.9" y="2087.1" w="20.0" h="20.0" />
