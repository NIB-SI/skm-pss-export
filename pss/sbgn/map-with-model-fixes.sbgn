                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/skm:rx00410" />
                </rdf:Bag>
              </bqbiol:is>
              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.3390/ijms22189768" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="14337.5" y="2379.0" w="20.0" h="20.0" />
      <port id="rx00410.in" x="14347.5" y="2364.0" />
      <port id="rx00410.out" x="14347.5" y="2414.0" />
    </glyph>
