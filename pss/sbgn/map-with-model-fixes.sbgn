    <glyph class="process" id="rx00413" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00413</html:p>
          <html:p>type: catalysis</html:p>
          <html:p>evidence: The first step is the removal of the amino group by the TAA family of aminotransferases to produce IPA.</html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
