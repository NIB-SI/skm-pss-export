              <bqmodel:isDescribedBy>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1111/tpj.13088" />
                  <rdf:li rdf:resource="http://identifiers.org/pubmed:33031436" />
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1371/journal.ppat.1008965" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
