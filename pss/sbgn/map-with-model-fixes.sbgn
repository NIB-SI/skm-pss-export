    <glyph class="process" id="rx00576" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00576</html:p>
          <html:p>type: transcriptional/translational activation</html:p>
          <html:p>mechanism: transcription</html:p>
          <html:p>evidence: HSFA6b, a Positive Regulator, Is Involved in ABA-Mediated Drought, Salt, and Thermotolerance. HSFA6b, a pivotal positive regulator, is required for ABA-mediated HSR. ABA Treatment and AREB1/ABF2 Coexpression Enhanced HSFA6b Promoter Activity.</html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
            <rdf:Description rdf:about="#rx00576">
