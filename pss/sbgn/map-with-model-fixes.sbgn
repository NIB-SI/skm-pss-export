        </annotation>
      </extension>
      <bbox x="17160.2" y="5795.1" w="20.0" h="20.0" />
      <port id="rx00198.in" x="17170.2" y="5780.1" />
      <port id="rx00198.out" x="17170.2" y="5830.1" />
    </glyph>
    <glyph class="association" id="rx00199" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00199</html:p>
          <html:p>type: binding/oligomerisation</html:p>
          <html:p>mechanism: inhibition of AGO by binding</html:p>
          <html:p>evidence: [...] we demonstrated that HCPro and AGO1 [...] interact with each other [...] in planta. These results [...] suggest the possibility that HCPro acts as an RNA silencing suppressor. </html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
