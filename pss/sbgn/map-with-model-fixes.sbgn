                <rdf:Bag>
                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1093/plphys/kiab334" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="18212.9" y="5027.3" w="20.0" h="20.0" />
      <port id="rx00925.in" x="18222.9" y="5012.3" />
      <port id="rx00925.out" x="18222.9" y="5062.3" />
    </glyph>
    <glyph class="process" id="rx00926" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00926</html:p>
          <html:p>type: protein activation</html:p>
          <html:p>mechanism: phosphorylation</html:p>
          <html:p>evidence: We speculated that CBL–CIPK may directly phosphorylate and activate CAX1/3. We further showed that CAX1/3 was phosphorylated by CIPK9, CIPK3 or CIPK26 in a CBL2/3-dependent manner </html:p>
        </html:body>
      </notes>
