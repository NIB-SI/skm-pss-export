                  <rdf:li rdf:resource="http://identifiers.org/pubmed:19297586" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="11485.2" y="5178.2" w="20.0" h="20.0" />
      <port id="rx00538.in" x="11495.2" y="5163.2" />
      <port id="rx00538.out" x="11495.2" y="5213.2" />
    </glyph>
