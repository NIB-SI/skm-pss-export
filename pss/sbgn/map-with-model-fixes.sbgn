      <notes>
        <html:body>
          <html:p>reaction: rx00541</html:p>
          <html:p>type: catalysis</html:p>
          <html:p>evidence: Prephenate is first transaminated to L-arogenate, then dehydrated and decarboxy-lated to phenylalanine [...] catalyzed by arogenate dehydratase (ADT) </html:p>
        </html:body>
      </notes>
      <extension>
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/" xmlns:sio="http://semanticscience.org/resource/">
            <rdf:Description rdf:about="#rx00541">
              <bqbiol:is>
