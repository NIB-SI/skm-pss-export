    <glyph class="process" id="rx00573" orientation="vertical">
      <notes>
        <html:body>
          <html:p>reaction: rx00573</html:p>
          <html:p>type: transcriptional/translational activation</html:p>
          <html:p>mechanism: translation</html:p>
          <html:p>evidence: Warm temperatures alter the structure of a hairpin structure in the mRNA of PIF7, which promotes its translation</html:p>
        </html:body>
