                  <rdf:li rdf:resource="http://identifiers.org/doi:10.1093/mp/sst071" />
                </rdf:Bag>
              </bqmodel:isDescribedBy>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </extension>
      <bbox x="14323.3" y="6029.9" w="20.0" h="20.0" />
      <port id="rx00342.in" x="14333.3" y="6014.9" />
      <port id="rx00342.out" x="14333.3" y="6064.9" />
    </glyph>
